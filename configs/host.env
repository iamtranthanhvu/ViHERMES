# One place for model, port and path settings on every host.
# `make` includes this file and scripts/serve.sh sources it: plain KEY=VALUE lines only,
# no spaces around =, no inline comments.
#
# No secrets here. HF_TOKEN is typed into the shell on the host and never written to a file.

# Hugging Face account and the two private repos that carry B2 and B3 to the B4 host.
HF_USER=iamtranthanhvu
HUB_EMBED_REPO=iamtranthanhvu/vihermes-bge-m3-ft
HUB_LORA_REPO=iamtranthanhvu/vihermes-qwen35-4b-conductor-lora

# Models. Fill each *_REVISION with a full commit hash from the model page so every host
# loads identical weights. An empty value means "latest", which is fine only for a first try.
GEN_MODEL=Qwen/Qwen3.5-4B
GEN_REVISION=
JUDGE_MODEL=Qwen/Qwen3.5-9B
JUDGE_REVISION=
EMBED_BASE=BAAI/bge-m3
EMBED_REVISION=
EMBED_MAX_SEQ_LENGTH=512

# Judge precision. Empty = bf16. Use the same value on all four hosts, otherwise the deltas
# against B1 are not comparable (typical values: fp8, awq).
JUDGE_QUANT=

# vLLM servers. Two models at once on a 48GB card is tight; lower the utilisation or the
# context length if a server runs out of memory.
VLLM_BIN=/workspace/vllm-env/bin/vllm
GEN_PORT=8000
JUDGE_PORT=8001
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
GEN_GPU_UTIL=0.45
JUDGE_GPU_UTIL=0.45
SERVE_TIMEOUT=900
LOG_DIR=outputs/logs

# Conductor LoRA adapter (B3, B4). The adapter is served under LORA_NAME by the generator server.
LORA_NAME=conductor
LORA_PATH=outputs/lora-conductor/adapter
LORA_RANK=16
LORA_ALPHA=32
LORA_EPOCHS=2
LORA_LR=2e-4
LORA_BATCH=1
LORA_GRAD_ACCUM=8
LORA_MAX_SEQ=8192

# Embedding fine-tuning (B2).
EMBED_EPOCHS=1
EMBED_LR=1e-5
EMBED_BATCH=16
EMBED_NEGATIVES=3

# Models for B4 (host H4), pinned by the commit hashes the training hosts recorded in their
# train_meta.json under "hub": EMBED_FT_REVISION from outputs/embed-ft/train_meta.json on H2,
# LORA_FT_REVISION from outputs/lora-conductor/train_meta.json on H3. Leave empty elsewhere.
EMBED_FT_REVISION=
LORA_FT_REVISION=

# Data and results.
SEED=42

# Chat (scripts/chat.sh): the B3 Conductor adapter, pinned by commit, and the port of the page.
# The hash is public information; the token that downloads it is not stored anywhere.
CHAT_LORA_REVISION=ca7768c356aa271d8c3a1337fe7204115728429e
CHAT_PORT=8080
CHAT_TIMEOUT=600
